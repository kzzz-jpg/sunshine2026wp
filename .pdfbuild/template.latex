  breaklines=true,
  breakanywhere=true,
  breakautoindent=false,
  frame=none,
  numbers=none,
  samepage=false,
}
\usepackage{framed}
\colorlet{shadecolor}{codebg}

% pandoc 產生的程式碼高亮巨集（必須先載入，才會定義 Shaded）
$highlighting-macros$

\renewenvironment{Shaded}{%
